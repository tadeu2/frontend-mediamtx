# Backend environment variables for mediamtx-admin-ui
# Copy this file to .env and edit:

# Listen address.
# Use 127.0.0.1 for local-only.
# Use the LXC LAN IP or 0.0.0.0 only with ADMIN_AUTH_TOKEN set.
BIND_ADDRESS=127.0.0.1

# Listen port
PORT=9088

# MediaMTX API URL
MEDIAMTX_API_URL=http://127.0.0.1:9997

# MediaMTX metrics URL
MEDIAMTX_METRICS_URL=http://127.0.0.1:9998/metrics

# MediaMTX config file path
MEDIAMTX_CONFIG_PATH=/etc/mediamtx/mediamtx.yml

# Optional on localhost, required if binding to LAN/VPN.
# Bearer token for API authentication.
# Generate with: openssl rand -hex 32
# ADMIN_AUTH_TOKEN=

# CORS origin (use frontend URL in production)
# CORS_ORIGIN=http://localhost:5173
