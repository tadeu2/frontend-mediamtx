# ══════════════════════════════════════════════════════════════════
# Backend environment variables for mediamtx-admin-ui
# ══════════════════════════════════════════════════════════════════
#
#   ⚠  LOCAL SENSITIVE FILE  ⚠
#   This file is gitignored (.gitignore already has .env).
#   NEVER commit .env to version control.
#
#   ⚠  PERMISSIONS  ⚠
#   Restrict access so only the service user can read it:
#     chmod 600 /opt/mediamtx-admin-ui/backend/.env
#     chown mediamtx-ui:mediamtx-ui /opt/mediamtx-admin-ui/backend/.env
#
#   ⚠  SYSTEMD OVERRIDE  ⚠
#   The service unit declares `EnvironmentFile=-/opt/.../.env`
#   AFTER its inline `Environment=` directives. This means any
#   variable set in .env OVERRIDES the unit's Environment= value.
#
#   If you only want to ADD secrets (without overriding BIND_ADDRESS,
#   PORT, etc.), do NOT redefine those variables here.
#
# ══════════════════════════════════════════════════════════════════

# Listen address.
# Use 127.0.0.1 for local-only (default, safe).
# Use the LXC LAN IP or 0.0.0.0 ONLY when ADMIN_AUTH_TOKEN is set.
BIND_ADDRESS=127.0.0.1

# Listen port
PORT=9088

# MediaMTX API URL
MEDIAMTX_API_URL=http://127.0.0.1:9997

# MediaMTX metrics URL
MEDIAMTX_METRICS_URL=http://127.0.0.1:9998/metrics

# MediaMTX config file path
MEDIAMTX_CONFIG_PATH=/etc/mediamtx/mediamtx.yml

# MediaMTX API authentication (optional).
# Only set these if MediaMTX has `authHttp` or `externalAuthenticationURL` enabled.
# MEDIAMTX_API_USERNAME=
# MEDIAMTX_API_PASSWORD=

# Optional on localhost, required if binding to LAN/VPN.
# Bearer token for API authentication.
# Generate with: openssl rand -hex 32
# ADMIN_AUTH_TOKEN=

# CORS origin (use frontend URL in production)
# CORS_ORIGIN=http://localhost:5173
