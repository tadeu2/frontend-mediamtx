[Unit]
Description=MediaMTX Admin UI — self-hosted read-only admin frontend
Documentation=https://github.com/tadeu2/frontend-mediamtx
After=network.target mediamtx.service
Requires=mediamtx.service

[Service]
Type=simple
User=mediamtx-ui
Group=mediamtx-ui

# App directory
WorkingDirectory=/opt/mediamtx-admin-ui/backend
ExecStart=/usr/bin/node /opt/mediamtx-admin-ui/backend/dist/backend/src/server.js
Restart=on-failure
RestartSec=5

# Environment
Environment=NODE_ENV=production
Environment=BIND_ADDRESS=127.0.0.1
Environment=PORT=9088
Environment=MEDIAMTX_API_URL=http://127.0.0.1:9997
Environment=MEDIAMTX_METRICS_URL=http://127.0.0.1:9998/metrics
Environment=MEDIAMTX_CONFIG_PATH=/etc/mediamtx/mediamtx.yml
# Environment=ADMIN_AUTH_TOKEN=change-me
# ═══ WARNING: EnvironmentFile OVERRIDES Environment= above ═══
# Variables defined in /opt/mediamtx-admin-ui/backend/.env WILL
# replace the inline Environment= values with the same name.
# If you want SECRETS ONLY, do NOT redefine BIND_ADDRESS, PORT,
# MEDIAMTX_API_URL etc. in .env — only add the ones that differ.
EnvironmentFile=-/opt/mediamtx-admin-ui/backend/.env

# Security hardening
# No root escalation needed — systemctl is accessed via polkit
# and journalctl via systemd-journal group membership.
# The mediamtx-ui user MUST be in the systemd-journal group.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
AmbientCapabilities=
# Node/Fastify calls os.networkInterfaces() while logging listen addresses,
# which uses AF_NETLINK on Linux.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadWritePaths=/opt/mediamtx-admin-ui

[Install]
WantedBy=multi-user.target
