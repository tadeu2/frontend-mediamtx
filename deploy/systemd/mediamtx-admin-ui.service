[Unit]
Description=MediaMTX Admin UI — self-hosted read-only admin frontend
Documentation=https://github.com/tadeu2/frontend-mediamtx
After=network.target mediamtx.service
Requires=mediamtx.service

[Service]
Type=simple
User=mediamtx-ui
Group=mediamtx-ui

# App directory
WorkingDirectory=/opt/mediamtx-admin-ui/backend
ExecStart=/usr/bin/node /opt/mediamtx-admin-ui/backend/dist/backend/src/server.js
Restart=on-failure
RestartSec=5

# Environment
Environment=NODE_ENV=production
Environment=BIND_ADDRESS=127.0.0.1
Environment=PORT=9088
Environment=MEDIAMTX_API_URL=http://127.0.0.1:9997
Environment=MEDIAMTX_METRICS_URL=http://127.0.0.1:9998/metrics
Environment=MEDIAMTX_CONFIG_PATH=/etc/mediamtx/mediamtx.yml
# Environment=ADMIN_AUTH_TOKEN=change-me
# Values in .env override the defaults above.
EnvironmentFile=-/opt/mediamtx-admin-ui/backend/.env

# Security hardening
# NoNewPrivileges disabled: sudo needed for systemctl/journalctl
# with allowlisted sudoers entries.
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
AmbientCapabilities=
# Node/Fastify calls os.networkInterfaces() while logging listen addresses,
# which uses AF_NETLINK on Linux.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadWritePaths=/opt/mediamtx-admin-ui

[Install]
WantedBy=multi-user.target
